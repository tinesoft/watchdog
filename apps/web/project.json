{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "command": "astro dev --host",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["seed"]
    },
    "build": {
      "command": "astro build && node scripts/build-sw.ts",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["seed"],
      "inputs": ["default", "toolchain", "{projectRoot}/public/data/*.json"]
    },
    "preview": {
      "command": "astro preview --host",
      "options": {
        "cwd": "apps/web"
      }
    },
    "typecheck": {
      "command": "astro check",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint": {
      "command": "eslint apps/web"
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "options": {
        "cwd": "apps/web"
      }
    },
    "e2e": {
      "command": "playwright test",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["seed"]
    },
    "seed": {
      "command": "node scripts/seed.ts",
      "options": {
        "cwd": "apps/web"
      },
      "cache": false
    },
    "collect": {
      "command": "node scripts/collect/index.ts",
      "options": {
        "cwd": "apps/web"
      },
      "cache": false
    }
  }
}
